# Never commit your real key. Copy this file to .env.local for local testing,
# or add the same variables in your cloud host's Environment Variables page.
OPENAI_API_KEY=sk-your-key-here

# Optional model overrides
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 豆包端到端实时语音（推荐）
VOLCENGINE_API_KEY=your_speech_api_key
VOLCENGINE_REALTIME_MODEL=1.2.1.1
VOLCENGINE_REALTIME_SPEAKER=zh_female_vv_uranus_bigtts
VOLCENGINE_REALTIME_SPEECH_RATE=-8
